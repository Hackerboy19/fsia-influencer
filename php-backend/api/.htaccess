# Every /api/* request is handled by index.php. Rewriting here (not only in the
# root .htaccess) is required: once Apache enters this folder its own rules
# apply, and seed data, config and libraries must never be served directly.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through to PHP (CGI / FastCGI hosts drop it)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(json|md|lock)$|^config">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

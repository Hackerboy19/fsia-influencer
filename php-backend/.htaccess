# FSIA Influencer — Apache / LiteSpeed configuration
Options -Indexes
DirectoryIndex disabled

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass the Authorization header through to PHP (CGI / FastCGI hosts drop it)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # API → PHP router
    RewriteCond %{REQUEST_URI} !^/api/index\.php
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

    # Pages, robots.txt and sitemap.xml are generated from Admin → SEO, so search
    # engines always see the current titles, descriptions and profile pages.
    # (Rules also cover pre-rendered copies left behind by older uploads.)
    RewriteRule ^(index\.html|robots\.txt|sitemap\.xml)$ api/render.php [L]
    RewriteRule ^[^/]+/index\.html$ api/render.php [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ api/render.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
